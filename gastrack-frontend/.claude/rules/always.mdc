# Critical Rules - Angular 21

## NEVER Use `any`
```typescript
// PROIBIDO
function process(data: any) { ... }
catch (error: any) { ... }

// CORRETO
function process<T>(data: T) { ... }
catch (error: unknown) {
  if (error instanceof Error) { ... }
}
```

## Always Use OnPush
```typescript
@Component({
  changeDetection: ChangeDetectionStrategy.OnPush,
})
```

## Always Standalone Components
```typescript
@Component({
  standalone: true,
  imports: [...],
})
```

## Use inject() Not Constructor DI
```typescript
// PROIBIDO
constructor(private service: MyService) {}

// CORRETO
private readonly service = inject(MyService);
```

## Use Signals for State
```typescript
// Private writable
private readonly dataSignal = signal<Data[]>([]);

// Public readonly
readonly data = this.dataSignal.asReadonly();

// Computed
readonly filtered = computed(() => this.dataSignal().filter(...));
```

